// Stdlib test: Amalgame.Database.NoSQL.Redis — RESP2 client speaking
// the wire protocol over a raw TCP socket. Assumes a Redis-compatible
// server (Redis / KeyDB / Dragonfly / Valkey) listening on
// 127.0.0.1:6379. The test runner gates this fixture on a TCP
// reachability probe; if no server is up, the runner SKIPs every case
// rather than this file failing to connect at runtime.
//
// All keys are namespaced under `amctest:` to keep the test isolated
// from any existing data in db 0. The cleanup pass at the end DELs
// everything we created so re-running the suite is idempotent.

namespace Tests

import Amalgame.Database.NoSQL.Redis

public class Program {
    public static void Main(string[] args) {

        // ── Open + connection-level health ────────────────

        let r = Redis.Open("127.0.0.1", 6379)
        if (Redis.IsOpen(r)) {
            Console.WriteLine("[PASS] open 6379")
        } else {
            Console.WriteLine("[FAIL] open 6379: " + Redis.LastError(r))
            return
        }

        let pingOk: bool = Redis.Ping(r)
        if (pingOk) {
            Console.WriteLine("[PASS] ping")
        } else {
            Console.WriteLine("[FAIL] ping: " + Redis.LastError(r))
        }

        // ── SET / GET round-trip ──────────────────────────

        let setOk: bool = Redis.Set(r, "amctest:greeting", "hello")
        if (setOk) {
            Console.WriteLine("[PASS] set greeting")
        } else {
            Console.WriteLine("[FAIL] set greeting: " + Redis.LastError(r))
        }

        let got: string = Redis.Get(r, "amctest:greeting")
        if (got == "hello") {
            Console.WriteLine("[PASS] get greeting")
        } else {
            Console.WriteLine("[FAIL] get greeting: got '" + got + "'")
        }

        // GET on a missing key returns the empty string. Use EXISTS
        // to disambiguate "missing" from "empty string value".
        let missing: string = Redis.Get(r, "amctest:doesnotexist")
        if (missing == "") {
            Console.WriteLine("[PASS] get missing is empty")
        } else {
            Console.WriteLine("[FAIL] get missing got '" + missing + "'")
        }

        // ── EXISTS ────────────────────────────────────────

        let existsHit: bool = Redis.Exists(r, "amctest:greeting")
        if (existsHit) {
            Console.WriteLine("[PASS] exists hit")
        } else {
            Console.WriteLine("[FAIL] exists hit returned false")
        }

        let existsMiss: bool = Redis.Exists(r, "amctest:doesnotexist")
        if (!existsMiss) {
            Console.WriteLine("[PASS] exists miss")
        } else {
            Console.WriteLine("[FAIL] exists miss returned true")
        }

        // ── INCR / DECR ───────────────────────────────────

        // Reset counter so re-runs are deterministic.
        Redis.Del(r, "amctest:counter")

        let incr1: int = Redis.Incr(r, "amctest:counter")
        let incr2: int = Redis.Incr(r, "amctest:counter")
        if (incr1 == 1 && incr2 == 2) {
            Console.WriteLine("[PASS] incr 1,2")
        } else {
            Console.WriteLine("[FAIL] incr got " + String_FromInt(incr1) + "," + String_FromInt(incr2))
        }

        let decr1: int = Redis.Decr(r, "amctest:counter")
        if (decr1 == 1) {
            Console.WriteLine("[PASS] decr to 1")
        } else {
            Console.WriteLine("[FAIL] decr got " + String_FromInt(decr1))
        }

        // ── EXPIRE ────────────────────────────────────────

        // Set a TTL on the counter; the actual TTL countdown isn't
        // exercised here (would slow the suite), just that EXPIRE
        // confirms the key existed and accepted the timeout.
        let expOk: bool = Redis.Expire(r, "amctest:counter", 60)
        if (expOk) {
            Console.WriteLine("[PASS] expire 60s")
        } else {
            Console.WriteLine("[FAIL] expire: " + Redis.LastError(r))
        }

        let expMissing: bool = Redis.Expire(r, "amctest:doesnotexist", 60)
        if (!expMissing) {
            Console.WriteLine("[PASS] expire on missing")
        } else {
            Console.WriteLine("[FAIL] expire on missing returned true")
        }

        // ── DEL + verify ──────────────────────────────────

        let delCount: int = Redis.Del(r, "amctest:greeting")
        if (delCount == 1) {
            Console.WriteLine("[PASS] del 1")
        } else {
            Console.WriteLine("[FAIL] del got " + String_FromInt(delCount))
        }

        let existsAfter: bool = Redis.Exists(r, "amctest:greeting")
        if (!existsAfter) {
            Console.WriteLine("[PASS] gone after del")
        } else {
            Console.WriteLine("[FAIL] still there after del")
        }

        // Cleanup the counter key (already has TTL but be explicit).
        Redis.Del(r, "amctest:counter")

        // ═══════════════════════════════════════════════════════
        //  v0.3 — Pipelining
        // ═══════════════════════════════════════════════════════
        //
        // Queue 5 commands, flush once, assert each reply lands at
        // the expected position. Cheap halving of round-trip cost
        // for chains of small commands — half the value of a Redis
        // client at all is paying for the network only once.

        Redis.PipelineBegin(r)
        Redis.PipelineSet(r, "amctest:p1", "alpha")
        Redis.PipelineSet(r, "amctest:p2", "beta")
        Redis.PipelineGet(r, "amctest:p1")
        Redis.PipelineIncr(r, "amctest:pcounter")
        Redis.PipelineDel(r, "amctest:p1")
        let nResp: int = Redis.PipelineExec(r)
        if (nResp == 5) {
            Console.WriteLine("[PASS] pipeline 5 replies")
        } else {
            Console.WriteLine("[FAIL] pipeline got " + String_FromInt(nResp))
        }

        let p0: string = Redis.PipelineResponseAt(r, 0)
        let p1: string = Redis.PipelineResponseAt(r, 1)
        let p2: string = Redis.PipelineResponseAt(r, 2)
        let p3: string = Redis.PipelineResponseAt(r, 3)
        let p4: string = Redis.PipelineResponseAt(r, 4)
        if (p0 == "OK" && p1 == "OK"
            && p2 == "alpha"
            && p3 == "1"
            && p4 == "1") {
            Console.WriteLine("[PASS] pipeline responses in order")
        } else {
            Console.WriteLine("[FAIL] pipeline: ["
                + p0 + "|" + p1 + "|" + p2 + "|" + p3 + "|" + p4 + "]")
        }

        // Cleanup the pipeline keys.
        Redis.Del(r, "amctest:p2")
        Redis.Del(r, "amctest:pcounter")

        // ═══════════════════════════════════════════════════════
        //  v0.3 — Pub/Sub
        // ═══════════════════════════════════════════════════════
        //
        // PUBLISH from a normal connection (`r` is in normal mode
        // here); SUBSCRIBE moves a second handle into subscriber
        // mode then WaitMessage blocks for the next push.
        //
        // We open a second connection `s` for the subscriber so the
        // publisher stays usable for normal commands. Real apps do
        // this routinely — pub/sub mode forbids most regular
        // commands on the same connection.

        let s = Redis.Open("127.0.0.1", 6379)
        if (Redis.IsOpen(s)) {
            Console.WriteLine("[PASS] open subscriber")
        } else {
            Console.WriteLine("[FAIL] open subscriber: " + Redis.LastError(s))
            Redis.Close(r)
            return
        }

        let subOk: bool = Redis.Subscribe(s, "amctest:bus")
        if (subOk) {
            Console.WriteLine("[PASS] subscribe amctest:bus")
        } else {
            Console.WriteLine("[FAIL] subscribe: " + Redis.LastError(s))
        }

        // Publish from r; expect 1 subscriber acknowledged.
        let nSubs: int = Redis.Publish(r, "amctest:bus", "ping")
        if (nSubs >= 1) {
            Console.WriteLine("[PASS] publish reaches >=1 subscriber")
        } else {
            Console.WriteLine("[FAIL] publish got " + String_FromInt(nSubs))
        }

        // Receive via WaitMessage (1s budget).
        let got1: bool = Redis.WaitMessage(s, 1000)
        if (got1) {
            let ch: string = Redis.LastChannel(s)
            let msg: string = Redis.LastMessage(s)
            if (ch == "amctest:bus" && msg == "ping") {
                Console.WriteLine("[PASS] WaitMessage returns channel + payload")
            } else {
                Console.WriteLine("[FAIL] got ch='" + ch + "' msg='" + msg + "'")
            }
        } else {
            Console.WriteLine("[FAIL] WaitMessage timed out")
        }

        Redis.Unsubscribe(s, "amctest:bus")
        Redis.Close(s)

        // ── Close ─────────────────────────────────────────

        Redis.Close(r)
        if (!Redis.IsOpen(r)) {
            Console.WriteLine("[PASS] closed")
        } else {
            Console.WriteLine("[FAIL] still open after close")
        }
    }
}
